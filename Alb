# main.tf

terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

# Reserve a global static IP
resource "google_compute_global_address" "default" {
  name = "${var.name}-ip"
}

# Health check
resource "google_compute_health_check" "default" {
  name               = "${var.name}-health-check"
  check_interval_sec = 10
  timeout_sec        = 5

  http_health_check {
    port         = 80
    request_path = "/health"
  }
}

# Instance group (backend)
resource "google_compute_instance_group" "default" {
  name      = "${var.name}-instance-group"
  zone      = "${var.region}-a"
  instances = var.instance_self_links

  named_port {
    name = "http"
    port = 80
  }
}

# Backend service
resource "google_compute_backend_service" "default" {
  name                  = "${var.name}-backend"
  protocol              = "HTTP"
  port_name             = "http"
  load_balancing_scheme = "EXTERNAL"
  timeout_sec           = 30
  health_checks         = [google_compute_health_check.default.id]

  backend {
    group           = google_compute_instance_group.default.id
    balancing_mode  = "UTILIZATION"
    capacity_scaler = 1.0
  }
}

# URL map (routing rules)
resource "google_compute_url_map" "default" {
  name            = "${var.name}-url-map"
  default_service = google_compute_backend_service.default.id

  # Optional: path-based routing
  host_rule {
    hosts        = ["*"]
    path_matcher = "allpaths"
  }

  path_matcher {
    name            = "allpaths"
    default_service = google_compute_backend_service.default.id

    path_rule {
      paths   = ["/api/*"]
      service = google_compute_backend_service.default.id
    }
  }
}

# HTTP target proxy
resource "google_compute_target_http_proxy" "default" {
  name    = "${var.name}-http-proxy"
  url_map = google_compute_url_map.default.id
}

# HTTPS target proxy (requires SSL cert)
resource "google_compute_target_https_proxy" "default" {
  name             = "${var.name}-https-proxy"
  url_map          = google_compute_url_map.default.id
  ssl_certificates = [google_compute_managed_ssl_certificate.default.id]
}

# Managed SSL certificate
resource "google_compute_managed_ssl_certificate" "default" {
  name = "${var.name}-ssl-cert"

  managed {
    domains = var.domains
  }
}

# HTTP forwarding rule (port 80)
resource "google_compute_global_forwarding_rule" "http" {
  name                  = "${var.name}-http-rule"
  ip_address            = google_compute_global_address.default.address
  port_range            = "80"
  target                = google_compute_target_http_proxy.default.id
  load_balancing_scheme = "EXTERNAL"
}

# HTTPS forwarding rule (port 443)
resource "google_compute_global_forwarding_rule" "https" {
  name                  = "${var.name}-https-rule"
  ip_address            = google_compute_global_address.default.address
  port_range            = "443"
  target                = google_compute_target_https_proxy.default.id
  load_balancing_scheme = "EXTERNAL"
}

# Firewall rule to allow LB health checks
resource "google_compute_firewall" "allow_health_check" {
  name    = "${var.name}-allow-health-check"
  network = "default"

  allow {
    protocol = "tcp"
    ports    = ["80", "443"]
  }

  # GCP health check IP ranges
  source_ranges = ["130.211.0.0/22", "35.191.0.0/16"]
}





# variables.tf

variable "project_id" {
  description = "GCP Project ID"
  type        = string
}

variable "region" {
  description = "GCP region"
  type        = string
  default     = "us-central1"
}

variable "name" {
  description = "Name prefix for all resources"
  type        = string
  default     = "my-alb"
}

variable "domains" {
  description = "Domains for managed SSL certificate"
  type        = list(string)
  default     = ["example.com"]
}

variable "instance_self_links" {
  description = "Self-links of VM instances to add to the backend"
  type        = list(string)
  default     = []
}


# outputs.tf

output "load_balancer_ip" {
  description = "Public IP of the load balancer"
  value       = google_compute_global_address.default.address
}

output "backend_service_id" {
  description = "Backend service ID"
  value       = google_compute_backend_service.default.id
}
